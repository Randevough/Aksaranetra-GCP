# Template only. Provision private file outside git, identical secrets on both VMs.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://aksaranetra.rafifernanda.site
APP_KEY=REPLACE_FROM_SECRET_MANAGER
BACKEND_SECRET=REPLACE_WITH_SAME_32_PLUS_CHARACTER_SECRET_ON_BOTH_NODES
FRONTEND_ORIGINS=https://aksaranetra.rafifernanda.site
TRUST_PROXY=1
HOST=0.0.0.0
PORT=8787
HA_MODE=1
RUN_MIGRATIONS=0
DB_CONNECTION=pgsql
# Private Cloud SQL address with private networking and verified TLS.
DB_HOST=REPLACE_PRIVATE_SQL_DNS
DB_PORT=5432
DB_DATABASE=aksaranetra
DB_USERNAME=aksaranetra
DB_PASSWORD=REPLACE_FROM_SECRET_MANAGER
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/sql/server-ca.pem
# Backend adapter contract pending; do not mistake these for implemented config.
ARTIFACT_STORE=gcs
GCS_BUCKET=linear-ellipse-513814-b9-ha-artifacts
GOOGLE_CLOUD_PROJECT=linear-ellipse-513814-b9
# Use attached VM identity / ADC; no GOOGLE_APPLICATION_CREDENTIALS key file.
AUDIT_TIMEOUT_MS=180000
RESULT_RETENTION_MS=604800000
CHROMIUM_LOW_RESOURCE_MODE=1
